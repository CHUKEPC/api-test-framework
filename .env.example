# Base URL override for REST API test requests
API_TEST_BASE_URL=https://jsonplaceholder.typicode.com

# Global authentication bearer token
API_TEST_AUTH_TOKEN=

# Default timeout in seconds for API requests
API_TEST_TIMEOUT=30.0

# Whether to verify SSL certificates (true/false)
API_TEST_VERIFY_SSL=true

# Default retry count on request failures
API_TEST_RETRIES=0
